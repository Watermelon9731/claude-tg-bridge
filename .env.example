# Telegram bot token from @BotFather
TG_BOT_TOKEN=123456:ABC-your-bot-token

# Comma-separated Telegram chat/user IDs allowed to use the bot.
# Get yours: message the bot, then check https://api.telegram.org/bot<TOKEN>/getUpdates
TG_ALLOWLIST=123456789

# Absolute path to the framework repo the agent reads/drives (has CLAUDE.md + scripts/vc.py)
REPO_DIR=/home/you/ai-concierge-agentic

# Optional
MODEL=claude-opus-4-8
POLL_SECONDS=90

# Auth: either run `claude login` on this box, or set:
# ANTHROPIC_API_KEY=sk-ant-...
